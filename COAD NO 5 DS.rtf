#include <iostream>\par
#include <string>\par
using namespace std;\par
\par
// ---------- STACK USING ARRAY ----------\par
#define MAX 5\par
\par
class ArrayStack \{\par
    string stack[MAX];\par
    int top;\par
\par
public:\par
    ArrayStack() \{\par
        top = -1;\par
    \}\par
\par
    void push(string page) \{\par
        if (top == MAX - 1)\par
            cout << "Stack Overflow" << endl;\par
        else\par
            stack[++top] = page;\par
    \}\par
\par
    void pop() \{\par
        if (top == -1)\par
            cout << "No previous page" << endl;\par
        else\par
            cout << "Back to: " << stack[top--] << endl;\par
    \}\par
\};\par
\par
// ---------- STACK USING LINKED LIST ----------\par
class LinkedStack \{\par
    struct Node \{\par
        string page;\par
        Node* next;\par
    \};\par
\par
    Node* top;\par
\par
public:\par
    LinkedStack() \{\par
        top = NULL;\par
    \}\par
\par
    void push(string page) \{\par
        Node* newNode = new Node;\par
        newNode->page = page;\par
        newNode->next = top;\par
        top = newNode;\par
    \}\par
\par
    void pop() \{\par
        if (top == NULL)\par
            cout << "No previous page" << endl;\par
        else \{\par
            cout << "Back to: " << top->page << endl;\par
\par
            Node* temp = top;\par
            top = top->next;\par
            delete temp;\par
        \}\par
    \}\par
\};\par
\par
// ---------- MAIN ----------\par
int main() \{\par
\par
    cout << "STACK USING ARRAY" << endl;\par
\par
    ArrayStack a;\par
\par
    a.push("Google");\par
    a.push("YouTube");\par
    a.push("Instagram");\par
\par
    a.pop();\par
    a.pop();\par
\par
\par
    cout << "\\nSTACK USING LINKED LIST" << endl;\par
\par
    LinkedStack l;\par
\par
    l.push("Google");\par
    l.push("YouTube");\par
    l.push("Instagram");\par
\par
    l.pop();\par
    l.pop();\par
\par
    return 0;\par
\}\par
